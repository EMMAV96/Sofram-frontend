# Desarrollo: copiar este archivo a .env (ignorado por Git).
VITE_API_BASE_URL=http://localhost:8080/api/v1
# Producción: definir VITE_API_BASE_URL en el entorno de build del frontend
# con la URL pública completa de la API, incluido /api/v1.
# Vite incorpora este valor al compilar: cambiarlo requiere un nuevo build.
# VITE_* es público. No incluir contraseñas, JWT secrets ni credenciales DB.
